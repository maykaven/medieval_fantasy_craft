# Build output (the pack zip we export for CurseForge)
# Committed copies for download live in releases/ (small zips only;
# since v0.4.0 the zip embeds a ~97MB jar and is built locally via build.ps1)
build/
releases/*.zip
!releases/medieval-fantasy-craft-0.1.0.zip
!releases/medieval-fantasy-craft-0.2.*.zip
!releases/medieval-fantasy-craft-0.3.*.zip

# Embedded jars are fetched by build.ps1, not committed
overrides/mods/*.jar

# Local testing junk
run/
logs/
crash-reports/

# OS noise
Thumbs.db
.DS_Store
